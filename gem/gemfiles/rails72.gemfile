# The gemspec's Rails floor; CI runs the suite here so `>= 7.2` stays true.
source "https://rubygems.org"

gemspec path: ".."

gem "rails", "~> 7.2.0"
gem "activeadmin", "~> 3.5"
gem "pundit"
gem "sprockets-rails"
gem "sqlite3"
gem "pg"
gem "rake"
gem "puma"
# ActiveSupport 7.2 passes `quirks_mode`, which json 3 rejects.
gem "json", "< 3"

group :test do
  gem "rspec-rails"
  gem "json_schemer"
  gem "standard", require: false
end
